# ─────────────────────────────────────────────────────────────────────
#  SENTRY environment
#  Copy this file to `.env` and paste a key. SENTRY runs fully without
#  one (deterministic Reasoner mode); a key upgrades the judgment layer
#  to a hosted model and unlocks the LLM reflection agent.
#
#  Two providers are supported and they are interchangeable. Set either.
# ─────────────────────────────────────────────────────────────────────

# Groq. Open-weight models on their own inference hardware, which puts
# each dispatch decision in the one-second range rather than the
# four-second range. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Alternative: llama-3.3-70b-versatile has a 50% larger per-minute token
# window but does not expose reasoning, so the trace shows fewer rows.

# Anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
SENTRY_MODEL=claude-opus-4-8

# Which provider to use. `auto` picks whichever key is present, and
# prefers Anthropic when both are. Set it explicitly to force one.
#   auto | claude | groq
SENTRY_PROVIDER=auto

# How the agent gathers evidence before it judges.
#   agentic  the model chooses which tools to call, over several turns
#   oneshot  the six evidence tools run locally, then ONE model call decides
#   auto     oneshot for providers with a metered token window (Groq),
#            agentic otherwise (Claude)
# One-shot exists because the fixed prompt is re-sent every turn: on Groq's free
# tier a two-turn decision costs more than a whole minute's allowance, so it
# could never finish. Same trace either way; the agent just does not pick its
# own evidence.
SENTRY_EVIDENCE=auto

# Reasoning effort per dispatch decision: low | medium | high | xhigh | max
# `medium` keeps decisions in the seconds range, which is the right latency
# for a live dispatch console. Groq maps xhigh and max onto its own `high`.
SENTRY_EFFORT=medium

# API server port (the Vite dev server proxies /api here).
PORT=8787

# Deterministic world seed. Same seed => byte-identical event stream,
# which is what makes the A/B eval harness meaningful.
SENTRY_SEED=20260721
