# ─────────────────────────────────────────────────────────────────────
#  SENTRY environment
#  Copy this file to `.env` and paste your key. SENTRY runs fully
#  without a key (deterministic Reasoner mode); the key upgrades the
#  judgment layer to Claude and unlocks the reflection agent.
# ─────────────────────────────────────────────────────────────────────

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for the dispatch + reflection agents.
SENTRY_MODEL=claude-opus-4-8

# Reasoning effort per dispatch decision: low | medium | high | xhigh | max
# `medium` keeps decisions ~2-4s, which is the right latency for a live
# dispatch console. Raise for higher-quality reasoning on hard incidents.
SENTRY_EFFORT=medium

# API server port (the Vite dev server proxies /api here).
PORT=8787

# Deterministic world seed. Same seed => byte-identical event stream,
# which is what makes the A/B eval harness meaningful.
SENTRY_SEED=20260721
