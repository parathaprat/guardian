# ─────────────────────────────────────────────────────────────────────
#  SENTRY environment
#
#  Copy this file to `.env`. SENTRY runs fully without a key, on its
#  deterministic Reasoner engine; a key upgrades the judgment layer to
#  Gemini and unlocks the LLM reflection agent.
# ─────────────────────────────────────────────────────────────────────

# Get a free key at https://aistudio.google.com/apikey
# (sign in with a Google account, "Create API key", no billing needed)
GEMINI_API_KEY=
# Flash-lite on purpose. The free tier meters requests per day PER MODEL and the
# allowance is not uniform: gemini-3.6-flash grants 20 a day, which the console
# spends in about a minute. Lite is the tier Google actually gives away, and it
# answers in ~1.6s rather than ~5s.
GEMINI_MODEL=gemini-3.1-flash-lite

# How the agent gathers evidence before it judges.
#   oneshot  the six evidence tools run locally, then ONE model call decides
#   agentic  the model chooses which tools to call, over several turns
# One-shot is the default because a multi-turn loop re-sends the whole prompt
# every turn, which triples the token cost of a decision for no better answer.
# The trace is identical either way; the agent just does not pick its own
# evidence.
SENTRY_EVIDENCE=oneshot

# Reasoning effort per dispatch decision: low | medium | high
# `low` is right for a live console. The evidence is already gathered and
# weighed before the model sees it, so higher settings buy latency the
# operator feels and little else.
SENTRY_EFFORT=low

# API server port (the Vite dev server proxies /api here).
PORT=8787

# Deterministic world seed. Same seed => byte-identical event stream,
# which is what makes the A/B eval harness meaningful.
SENTRY_SEED=20260721
