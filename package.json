{
  "name": "calvis-sentry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SENTRY — an AI dispatch agent for physical security operations. Built for Calvis.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/server/eval/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
